# Image du serveur de licences de l'éditeur. Contexte de build : la racine du dépôt.
#   docker build -f deploy/Dockerfile.license-server -t immogest/license-server:dev .
# La clé privée Ed25519 n'est JAMAIS dans l'image : montez-la (LICENSE_SERVER_CLE_PRIVEE_CHEMIN, lecture seule).
FROM eclipse-temurin:24-jdk AS build
WORKDIR /src
COPY backend/ backend/
WORKDIR /src/backend
RUN --mount=type=cache,target=/root/.m2 \
    ./mvnw -B -q -pl license-server -am package -DskipTests \
 && mkdir /out \
 && cp "$(ls license-server/target/license-server-*.jar | grep -v original | head -n1)" /out/app.jar

FROM eclipse-temurin:24-jre
RUN apt-get update && apt-get install -y --no-install-recommends curl \
 # apt 3.2.1 corrige CVE-2026-109518 (HIGH) présent dans eclipse-temurin:21-jre ; inutile dès que l'image de base l'embarque
 && apt-get install -y --no-install-recommends --only-upgrade apt \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10002 --no-create-home licences
COPY --from=build /out/app.jar /app/app.jar
USER licences
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=60 -Duser.timezone=UTC"
EXPOSE 8090
# Sans actuator : toute réponse HTTP (même 404 « aucune version publiée ») prouve que le serveur répond
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=8 \
  CMD curl -s -o /dev/null http://localhost:8090/api/v1/versions/derniere || exit 1
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
